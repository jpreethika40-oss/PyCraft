# PyCraft Environment Configuration (Phase 2)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env file or real API keys to version control.

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (e.g., gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
